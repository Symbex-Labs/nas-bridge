# NAS Bridge — environment variables
# Copy this file to .env (in the nas-bridge/ directory) and fill in the values.
# docker-compose.yml reads it automatically via `env_file: .env`.

# ── Required ──────────────────────────────────────────────────────────────────

# Static Bearer token.  Every API request must include:
#   Authorization: Bearer <value>
# Generate a strong token with:
#   openssl rand -hex 32
BRIDGE_TOKEN=change-me-to-a-strong-random-token

# ── Optional ──────────────────────────────────────────────────────────────────

# Absolute path to the Jobs share *inside the container*.
# This maps to the host path you set in docker-compose.yml.
# Default: /volume1/Jobs
ROOT_PATH=/volume1/Jobs

# Interface to bind to (0.0.0.0 = all interfaces, required for Docker).
# Default: 0.0.0.0
HOST=0.0.0.0

# TCP port the service listens on inside the container.
# The host-side port is configured in docker-compose.yml (default 8080).
# Default: 8080
PORT=8080

# Uvicorn log level: debug | info | warning | error | critical
# Default: info
LOG_LEVEL=info
